{
    "name": "jumaitong/pay-sdk",
    "description": "Pay 支付中心 PHP SDK（内部项目接入专用）",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Jumaitong Backend Team",
            "email": "backend@jumaitong.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "Jumaitong\\Pay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jumaitong\\Pay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse src --level=8",
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
